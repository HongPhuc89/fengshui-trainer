[Unit]
Description=Gunicorn — Fengshui Trainer Django
After=network.target redis-server.service

[Service]
User=fengshui
Group=fengshui
WorkingDirectory=/srv/fengshui/src/backend
EnvironmentFile=/srv/fengshui/.env
ExecStart=/srv/fengshui/venv/bin/gunicorn \
    config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile /var/log/fengshui/gunicorn-access.log \
    --error-logfile /var/log/fengshui/gunicorn-error.log
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
