[Unit]
Description=Celery Beat — Fengshui Trainer
After=network.target redis-server.service fengshui-gunicorn.service

[Service]
User=fengshui
Group=fengshui
WorkingDirectory=/srv/fengshui/src/backend
EnvironmentFile=/srv/fengshui/src/backend/.env
ExecStart=/srv/fengshui/.venv/bin/celery \
    -A config beat \
    -l info \
    --logfile=/var/log/fengshui/celery-beat.log
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
