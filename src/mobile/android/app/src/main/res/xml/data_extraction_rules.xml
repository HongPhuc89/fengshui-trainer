<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Same reasoning as backup_rules.xml: the device client id must never
  travel to another handset through cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
