# General Template
DEBUG=True
SECRET_KEY=django-insecure-replace-this-in-prod
DATABASE_URL=sqlite:///db.sqlite3

# Email Settings (Gmail)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Video Storage Backend: 'local' (default) hoặc 'bunny'
# Khi dùng 'bunny': set 3 biến BUNNY_* bên dưới
VIDEO_STORAGE_BACKEND=local

# Bunny Stream — lấy từ Bunny Dashboard > Stream Library > API
BUNNY_LIBRARY_ID=your-numeric-library-id
BUNNY_API_KEY=your-stream-api-key
# Pull zone hostname (dùng 'iframe.mediadelivery.net' nếu chưa có custom domain)
BUNNY_CDN_HOSTNAME=iframe.mediadelivery.net

# Bunny Storage Zone — for encrypted .bin chapter files (Feature 26)
# Setup: Bunny Dashboard > Storage > Add Storage Zone, then add a Pull Zone.
# Run `python manage.py verify_bunny_config` after filling these in.
BUNNY_STORAGE_ZONE=thienthu-encrypted-books
BUNNY_STORAGE_API_KEY=your-storage-zone-password-here
BUNNY_STORAGE_CDN_HOSTNAME=thienthu-books.b-cdn.net
# Region for Storage API endpoint. Options: de | ny | la | sg | syd | br | jh
# Recommended: sg (Singapore) for Vietnam/SEA users.
BUNNY_STORAGE_REGION=sg

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Environment: development | staging | production (Sentry only when staging/production)
APP_ENV=development
# SENTRY_DSN=  # optional; leave empty in dev

# Supabase Storage (private bucket, pre-signed URLs for images & PDFs)
# Get from: Supabase Dashboard > Project Settings > Storage > S3 Connection
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_S3_ACCESS_KEY_ID=your-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-secret-access-key
SUPABASE_STORAGE_BUCKET=media
SUPABASE_REGION=ap-southeast-1
