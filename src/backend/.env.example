# General Template
DEBUG=True
SECRET_KEY=django-insecure-replace-this-in-prod
DATABASE_URL=sqlite:///db.sqlite3

# Email Settings (Gmail)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Bunny Stream API
BUNNY_API_KEY=your-api-key
BUNNY_VIDEO_LIBRARY_ID=your-library-id
BUNNY_STREAM_HOSTNAME=video.your-domain.com

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Environment: development | staging | production (Sentry only when staging/production)
APP_ENV=development
# SENTRY_DSN=  # optional; leave empty in dev

# Supabase Storage (private bucket, pre-signed URLs for images & PDFs)
# Get from: Supabase Dashboard > Project Settings > Storage > S3 Connection
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_S3_ACCESS_KEY_ID=your-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-secret-access-key
SUPABASE_STORAGE_BUCKET=media
SUPABASE_REGION=ap-southeast-1
