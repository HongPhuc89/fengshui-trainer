# General Template
DEBUG=True
SECRET_KEY=django-insecure-replace-this-in-prod
DATABASE_URL=sqlite:///db.sqlite3

# Email Settings — Resend via SMTP
# Get credentials from: https://resend.com/settings/smtp
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-resend-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Forgot-password OTP configuration
# OTP_EXPIRY_MINUTES: how long an OTP is valid (minutes)
OTP_EXPIRY_MINUTES=5
# OTP_MAX_ATTEMPTS: wrong attempts before OTP is voided
OTP_MAX_ATTEMPTS=5
# OTP_DAILY_LIMIT: max OTP requests per email per day
OTP_DAILY_LIMIT=5
# PASSWORD_RESET_TOKEN_EXPIRY_MINUTES: how long the reset token is valid after OTP verification
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15

# Video Storage Backend: 'local' (default) hoặc 'bunny'
# Khi dùng 'bunny': set 3 biến BUNNY_* bên dưới
VIDEO_STORAGE_BACKEND=local

# Bunny Stream — lấy từ Bunny Dashboard > Stream Library > API
BUNNY_LIBRARY_ID=your-numeric-library-id
BUNNY_API_KEY=your-stream-api-key
# Pull zone hostname (dùng 'iframe.mediadelivery.net' nếu chưa có custom domain)
BUNNY_CDN_HOSTNAME=iframe.mediadelivery.net

# Bunny Storage Zone — for encrypted .bin chapter files (Feature 26) and PDF infographics (Feature 30)
# Setup: Bunny Dashboard > Storage > Add Storage Zone, then add a Pull Zone.
# Run `python manage.py verify_bunny_config` after filling these in.
BUNNY_STORAGE_ZONE=thienthu-encrypted-books
BUNNY_STORAGE_API_KEY=your-storage-zone-password-here
BUNNY_STORAGE_CDN_HOSTNAME=thienthu-books.b-cdn.net
# Region for Storage API endpoint. Options: de | ny | la | sg | syd | br | jh
# Recommended: sg (Singapore) for Vietnam/SEA users.
BUNNY_STORAGE_REGION=sg
# Bunny account-level API key — for CDN cache purge (e.g. after QR image re-upload).
# Get from: https://dash.bunny.net/account/apikey (Account > API)
BUNNY_ACCOUNT_API_KEY=your-account-api-key-here

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Environment: development | staging | production (Sentry only when staging/production)
APP_ENV=development
# SENTRY_DSN=  # optional; leave empty in dev

# ipinfo.io — IP geolocation (optional, free tier works without token up to 50k req/month)
# IPINFO_TOKEN=

# Supabase Storage (private bucket, pre-signed URLs for images & PDFs)
# Get from: Supabase Dashboard > Project Settings > Storage > S3 Connection
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_S3_ACCESS_KEY_ID=your-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-secret-access-key
SUPABASE_STORAGE_BUCKET=media
SUPABASE_REGION=ap-southeast-1

# Supabase direct DB connection (for /api/health-supabase/)
# Get from: Supabase Dashboard > Project Settings > Database > Connection string (URI)
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Health check secret token — generate with: openssl rand -hex 32
HEALTH_SECRET_TOKEN=replace-with-a-random-secret
