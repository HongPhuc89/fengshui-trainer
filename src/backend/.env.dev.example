DEBUG=True
APP_ENV=development

SECRET_KEY=django-insecure-dev-key
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0

# Bunny Local Fallback
BUNNY_USE_LOCAL_FALLBACK=True

# Sentry: leave empty in dev (only sends when APP_ENV=staging|production)
# SENTRY_DSN=

# Supabase Storage (private bucket, pre-signed URLs for images & PDFs)
# Get from: Supabase Dashboard > Project Settings > Storage > S3 Connection
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_S3_ACCESS_KEY_ID=your-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-secret-access-key
SUPABASE_STORAGE_BUCKET=media
SUPABASE_REGION=ap-southeast-1
