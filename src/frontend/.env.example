# Backend server URL (used by Vite dev proxy for /api and /media)
VITE_BACKEND_URL=http://127.0.0.1:8000

# API base URL sent in axios requests.
# Leave empty to use same-origin /api (works with Vite proxy in dev, and nginx in prod).
# Set to full URL (e.g. https://api.example.com/api) if backend is on a different domain.
VITE_API_BASE_URL=
